# Gerado a partir de infra/nginx/templates/default.conf.template (envsubst só em ${NGINX_*}).

# DNS interno do Docker, para resolver os serviços a cada requisição (contêiner reiniciado troca de IP)
resolver 127.0.0.11 valid=10s ipv6=off;

# IP real do visitante: a requisição chega do proxy do Coolify (rede interna do Docker).
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# O TLS termina no proxy do Coolify (Traefik/Caddy); repassa esquema, porta e cadeia de IPs originais.
map $http_x_forwarded_proto $proto_original {
    default $http_x_forwarded_proto;
    ''      $scheme;
}
map $http_x_forwarded_port $porta_original {
    default $http_x_forwarded_port;
    ''      $server_port;
}
map $http_x_forwarded_for $xff {
    default $http_x_forwarded_for;
    ''      $remote_addr;
}

# Site: HTML (index.html e rotas do Angular) sempre revalidado, para pegar a versão nova após o deploy;
# os demais arquivos (js/css com hash) mantêm o cache longo enviado pelo contêiner do front.
map $upstream_http_content_type $cache_do_site {
    ~*^text/html  "no-cache";
    default       $upstream_http_cache_control;
}

# Robôs de prévia de link (WhatsApp, Facebook/Instagram/iMessage, X, Telegram, LinkedIn, Slack, Discord…).
# Eles não executam JavaScript: em /imovel/{id}/... recebem do backend um HTML com as tags Open Graph do anúncio
# (foto de capa, título e valor). Buscadores (Google, Bing) ficam de fora e recebem o site normal.
map $http_user_agent $robo_previa {
    default 0;
    "~*(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterestbot|redditbot|vkshare|embedly|iframely|mastodon)" 1;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    server_tokens off;

    set $backend http://backend:8080;
    set $soketi  http://soketi:6001;
    set $site    http://frontend:80;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Health/métricas do Spring ficam só na rede interna
    location ^~ /actuator/ {
        return 404;
    }

    # API do site (sessão + CSRF) e API aberta (Bearer)
    location ^~ /app/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $backend;
        proxy_read_timeout 60s;
    }
    location ^~ /api/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $backend;
        proxy_read_timeout 60s;
    }

    # Tempo real: o pusher-js conecta em wss://<domínio>/ws/app/<key>; o Soketi espera /app/<key>
    location ^~ /ws/ {
        rewrite ^/ws/(.*)$ /$1 break;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $soketi;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Página do imóvel: robôs de prévia de link vão para a prévia do backend (ver map $robo_previa);
    # visitantes recebem o site normal, como em "location /".
    location ~ ^/imovel/[0-9]+(/|$) {
        include /etc/nginx/snippets/proxy.conf;
        if ($robo_previa) {
            rewrite ^/imovel/([0-9]+) /app/public/previa/imovel/$1 break;
            proxy_pass $backend;
        }
        proxy_pass $site;
        proxy_hide_header Cache-Control;
        add_header Cache-Control $cache_do_site always;
    }

    # Site (Angular)
    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $site;
        proxy_hide_header Cache-Control;
        add_header Cache-Control $cache_do_site always;
    }
}
